# Copy to .env and fill in. Never commit the real .env.
PORT=5000
NODE_ENV=development

MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary (file uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Allowed browser origins: the website and the admin panel
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5175

# Workshop emails, sent from the academy's Gmail account.
# SMTP_PASS is a Gmail app password (16 letters), not the normal Gmail password:
# Google Account > Security > 2-Step Verification > App passwords.
# Leave SMTP_PASS empty to switch emails off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=superbloomacademy@gmail.com
SMTP_PASS=
# Gmail only sends as the account itself, so keep this address the same as SMTP_USER
MAIL_FROM=Superbloom Academy <superbloomacademy@gmail.com>
# Used for the "Check my registration" and "Stop these emails" links in emails
SITE_URL=https://www.superbloomacademy.in

# WhatsApp campaigns, sent through Meta's WhatsApp Business Cloud API from the academy's
# business number (never a personal WhatsApp). Setup steps: docs/WHATSAPP-SETUP-GUIDE.md
# Leave WHATSAPP_TOKEN empty to switch WhatsApp off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ID=
# Any long random text you make up; typed again in Meta when the webhook is added
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app (Settings > Basic); lets the server check webhook calls are from Meta
WHATSAPP_APP_SECRET=
